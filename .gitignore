# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment local files (Keep .env.example tracked)
.env*.local
.env
!.env.example

# Local SQLite databases & WAL mode logs
data/*.sqlite3
data/*.sqlite3-journal
data/*.sqlite3-wal
data/*.sqlite3-shm
!data/.gitkeep

# Uploaded documents (keep directory via .gitkeep)
public/uploads/legality/*
!public/uploads/legality/.gitkeep

# Local data backups
/backups/
*.tar.gz
*.zip

# OS generated files
.DS_Store
Thumbs.db
*.pem

# TypeScript cache
*.tsbuildinfo
