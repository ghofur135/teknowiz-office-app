# ==============================================================================
# WIZBILLING - ENVIRONMENT CONFIGURATION
# PT Tekno Wiz Indonesia
# ==============================================================================

# URL Publik Aplikasi (digunakan untuk link verifikasi online & QR code pada faktur/kwitansi)
# Contoh: https://billing.teknowiz.id atau http://localhost:3000
NEXT_PUBLIC_APP_URL=https://billing.teknowiz.id

# Port server lokal saat menjalankan aplikasi (default: 3000)
PORT=3000

# Secret Key untuk penandatanganan Cookie Sesi Login (HMAC SHA-256)
SESSION_SECRET=teknowiz-secret-key-2026-auth-session

# ------------------------------------------------------------------------------
# KONEKSI DATABASE (OPSIONAL)
# ------------------------------------------------------------------------------
# Secara default, sistem menggunakan SQLite lokal di ./data/billing.sqlite3.
# Jika ingin menggunakan Turso Cloud SQLite (agar bisa diakses online serverless):
# LIBSQL_URL=libsql://nama-database.turso.io
# LIBSQL_AUTH_TOKEN=token-rahasia-turso
